<?xml version="1.0"?>
<package format="3">
  <name>s622_dual_admittance</name>
  <version>0.1.0</version>
  <description>Six-dimensional position-based admittance control for the S622 dual-arm robot.</description>
  <maintainer email="1197226282@qq.com">dsl</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>s622_dual_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>s622_dual_moveit_config</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
