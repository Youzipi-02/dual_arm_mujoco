            type="mesh"
            mesh="middleware_mesh"
            contype="0"
            conaffinity="0"
            density="0"
            group="1"
            rgba="0.08 0.72 0.82 1"/>

      <!-- 碰撞实体与 STL 对齐；group=3 可单独显示，空白区域不再参与碰撞。 -->
      <!-- 底座：70 × 10 × 70 mm。 -->
      <geom name="middleware_collision_base"
            type="box"
            pos="-0.060108197 -0.095620256 0"
            size="0.034999999 0.004999999 0.035000000"
            group="3"/>

      <!-- 立板背层：3 mm 厚，保留盲孔底部；孔沿局部 X 轴，深约 12 mm。 -->
      <geom name="middleware_collision_back"
            type="box"
            pos="-0.066108197 0.009379741 0"
            size="0.001500003 0.099999998 0.025000000"
            group="3"/>

      <!-- 立板前层：12 个凸块围成原 STL 的十二边形孔，孔外接圆直径约 16 mm。 -->
