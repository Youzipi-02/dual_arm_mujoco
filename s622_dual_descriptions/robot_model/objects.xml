  <worldbody>
    <!-- 导线：局部 Z 轴为轴线，原点位于一端 -->
    <body name="wire"
          pos="-0.23 0.35 0.7566"
          quat="0.7071067811865476 0 0.7071067811865476 0">

      <freejoint name="wire_free"/>

      <inertial pos="0 0 0.03"
                mass="0.020551"
                diaginertia="6.2282e-6 6.2282e-6 1.2587e-7"/>

      <geom name="wire_visual"
            type="mesh"
            mesh="wire_mesh"
            contype="0"
            conaffinity="0"
            density="0"
            group="1"
            rgba="0.54 0.25 0.16 1"/>

      <!-- cylinder 的第二个 size 是半长度 -->
      <geom name="wire_collision"
          type="cylinder"
          pos="0 0 0.03"
          size="0.0035 0.03"
          condim="6"
          friction="1.5 0.02 0.001"
          solref="0.008 1"
          group="3"/>
    </body>

    <!-- 铜端子：局部 Z 轴为轴线，原点位于一端 -->
    <body name="copper_terminal"
          pos="0.23 0.35 0.7606"
          quat="0.7071067811865476 0 0.7071067811865476 0">

      <freejoint name="terminal_free"/>

      <inertial pos="0 0 0.015"
                mass="0.021809"
                diaginertia="2.1073e-6 2.1073e-6 9.4324e-7"/>

      <geom name="terminal_visual"
            type="mesh"
            mesh="terminal_mesh"
            contype="0"
            conaffinity="0"
            density="0"
            group="1"
            rgba="0.72 0.38 0.12 1"/>

      <!-- 每次绕局部 Z 转 22.5°，形成 16 段管壁。
           当前 compiler 使用 angle="radian"。 -->
      <replicate count="16"
                 euler="0 0 0.39269908169872414">
        <geom name="terminal_wall"
              type="box"
              pos="0.0065 0 0.015"
              size="0.001 0.0014631775 0.015"
              condim="6"
              friction="1.5 0.02 0.001"
              solref="0.008 1"
              group="3"/>
      </replicate>
    </body>

    <!-- 中间件：固定到世界，没有 freejoint -->
    <body name="middleware"
          pos="0 0.25 0.854"
          quat="0 0 0.7071067811865476 0.7071067811865476">

