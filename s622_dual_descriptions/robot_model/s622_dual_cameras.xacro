<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 与 cameras.xml 中的相机位置和朝向保持一致。 -->
  <link name="global_camera_mujoco_frame"/>

  <joint name="world_to_global_camera" type="fixed">
    <parent link="world"/>
    <child link="global_camera_mujoco_frame"/>
    <origin xyz="0 0.25 1.8" rpy="0 0 0"/>
  </joint>

  <!-- MuJoCo 相机坐标系转为 ROS 光学坐标系。 -->
  <link name="global_camera_optical_frame"/>

  <joint name="global_camera_to_optical" type="fixed">
    <parent link="global_camera_mujoco_frame"/>
    <child link="global_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${pi} 0 0"/>
  </joint>

</robot>