<?xml version="1.0" encoding="utf-8"?>
<!-- mujoco：MJCF 模型根节点，model 指定模型名称。 -->
<mujoco model="s622_dual_force_test">
  <!-- compiler：设置编译选项；使用弧度、指定网格目录，并保留静态刚体和显式惯性参数。 -->
  <compiler angle="radian" meshdir="../meshes/robot" fusestatic="false" inertiafromgeom="false" />

  <!-- default：声明可复用的默认属性；嵌套 default 用 class 命名，供模型元素显式引用。 -->
  <default>
    <default class="s622_position">
      <!-- position：位置伺服默认参数；kp/kv 为位置/速度反馈增益，启用控制量和输出力限幅。 -->
      <position kp="200" kv="20" gear="1" ctrllimited="true" forcelimited="true" />
    </default>

    <!--
      手指以米为单位；1 mm 伺服误差在 kp=1500 N/m 下约产生 1.5 N/指。
      独立于机械臂增益，执行器仍受下方 150 N 力限幅约束。
    -->
    <default class="s622_gripper_position">
      <position kp="1500" kv="20" gear="1" ctrllimited="true" forcelimited="true" />
    </default>

    <!--
      指尖接触参数：friction 设置摩擦系数，solref="0.01 1" 设置 10 ms 时间常数和阻尼比 1。
      接触刚度影响闭爪预压对应的伺服位置误差、法向力和几何穿透量。
    -->
    <default class="s622_fingertip_contact">
      <geom friction="1.0 0.02 0.001" solref="0.008 1" />
    </default>
  </default>

  <!-- asset：声明可复用资源；mesh 加载 STL 网格，文件路径相对于 compiler.meshdir。 -->
  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL" />
    <mesh name="shoulder_link" content_type="model/stl" file="shoulder_link.STL" />
    <mesh name="upperarm_link" content_type="model/stl" file="upperarm_link.STL" />
    <mesh name="forearm_link" content_type="model/stl" file="forearm_link.STL" />
    <mesh name="wrist1_link" content_type="model/stl" file="wrist1_link.STL" />
    <mesh name="wrist2_link" content_type="model/stl" file="wrist2_link.STL" />
    <mesh name="wrist3_link" content_type="model/stl" file="wrist3_link.STL" />
    <mesh name="ft_sensor_link" content_type="model/stl" file="ft_sensor_link.STL" />
    <mesh name="gripper_base_link" content_type="model/stl" file="gripper_base_link.STL" />
    <mesh name="finger1_link" content_type="model/stl" file="finger1_link.STL" />
    <mesh name="finger2_link" content_type="model/stl" file="finger2_link.STL" />
  </asset>

  <!--
    worldbody：世界坐标系下的刚体树，嵌套 body 表示父子装配关系。
    双臂固定装配；沿用原模型的 0.753 m 安装高度和全部 link/joint 名称。
    各有质量 body 的 gravcomp=1 启用重力补偿；关节 actuatorgravcomp=true
    将补偿计入总执行器力，由原 actuatorfrcrange 限制 PD 与补偿的合力。
  -->
  <worldbody>
    <!-- light：场景光源；targetbodycom 使光源朝向指定刚体的质心。 -->
    <light name="spotlight1" mode="targetbodycom" target="left_wrist3_link" pos="0 -1 2" />
    <light name="spotlight2" mode="targetbodycom" target="right_wrist3_link" pos="0 -1 2" />

    <!-- body：定义局部坐标系及其子刚体；pos/quat 相对于父坐标系，无 joint 的刚体与父刚体固定连接。 -->
