        <inertial
          pos="-0.00049027 -0.00045095 0.032527"
          quat="0.2655 0.648354 -0.281455 0.65569"
          mass="0.29035"
          diaginertia="0.000732373 0.000517121 0.000508766"
        />

        <!-- geom：定义几何形状；此视觉网格用 contype=0、conaffinity=0 关闭碰撞，group=1 用于显示分组。 -->
        <geom
          pos="0 0 0"
          quat="1 0 0 0"
          type="mesh"
          contype="0"
          conaffinity="0"
          group="1"
          rgba="1 1 1 1"
          density="0"
          mesh="base_link"
          name="left_base_link_visual_0"
        />

        <!-- 碰撞 geom：参与接触计算；group=3 用于显示分组，本身不决定碰撞是否启用。 -->
