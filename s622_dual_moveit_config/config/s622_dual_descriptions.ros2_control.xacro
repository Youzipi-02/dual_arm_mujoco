<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="s622_dual_descriptions_ros2_control" params="name initial_positions_file mujoco_model mujoco_headless">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
              <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>

              <param name="mujoco_model">${mujoco_model}</param>

              <param name="initial_keyframe">home</param>
              <param name="headless">${mujoco_headless}</param>
              <param name="sim_speed_factor">1.0</param>
            </hardware>
            <joint name="left_j1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_j2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_j3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_j4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_j5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_j6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_j6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_j6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_j6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_finger1_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_finger1_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="left_finger2_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_finger2_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_finger1_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_finger1_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_finger2_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_finger2_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <sensor name="left_ft_sensor">
              <param name="mujoco_type">fts</param>
              <param name="mujoco_sensor_name">left_ft_sensor</param>

              <state_interface name="force.x"/>
              <state_interface name="force.y"/>
              <state_interface name="force.z"/>
              <state_interface name="torque.x"/>
              <state_interface name="torque.y"/>
              <state_interface name="torque.z"/>
            </sensor>

            <sensor name="right_ft_sensor">
              <param name="mujoco_type">fts</param>
              <param name="mujoco_sensor_name">right_ft_sensor</param>

              <state_interface name="force.x"/>
              <state_interface name="force.y"/>
              <state_interface name="force.z"/>
              <state_interface name="torque.x"/>
              <state_interface name="torque.y"/>
              <state_interface name="torque.z"/>
            </sensor>

        </ros2_control>
    </xacro:macro>
</robot>
